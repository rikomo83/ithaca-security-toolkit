#!/usr/bin/env bash
set -u

BASE="${ITHACA_BASE_DIR:-/opt/ithaca-security}"
ENGINE="${ITHACA_ENGINE:-v12}"

case "$ENGINE" in
    legacy)
        exec "$BASE/bin/ithaca-check-legacy" "$@"
        ;;
    v12)
        exec "$BASE/bin/ithaca-check-v12" "$@"
        ;;
    *)
        printf 'ITHACA_ENGINE non valido: %s (valori: legacy, v12)\n' "$ENGINE" >&2
        exit 3
        ;;
esac
