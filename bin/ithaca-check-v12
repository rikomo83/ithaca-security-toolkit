#!/usr/bin/env bash
set -u

if [[ "$EUID" -ne 0 ]]; then
    echo "Esegui con sudo: sudo ithaca-check" >&2
    exit 1
fi

ITHACA_BASE_DIR="${ITHACA_BASE_DIR:-/opt/ithaca-security}"
export ITHACA_BASE_DIR
CONF="$ITHACA_BASE_DIR/config/ithaca.conf"

[[ -f "$CONF" ]] && source "$CONF"

REPORT_DIR="${REPORTS:-$ITHACA_BASE_DIR/reports}"
NOW="$(date '+%Y-%m-%d_%H-%M-%S')"
REPORT="$REPORT_DIR/check-$NOW.txt"
LATEST="$REPORT_DIR/check-latest.txt"

mkdir -p "$REPORT_DIR"
exec > >(tee "$REPORT") 2>&1

# Sentinel compatibility layer used by the eight modules not migrated yet.
source "$ITHACA_BASE_DIR/lib/common.sh"

# Core API 1.
source "$ITHACA_BASE_DIR/core/bootstrap.sh"
source "$ITHACA_BASE_DIR/core/runner.sh"
source "$ITHACA_BASE_DIR/core/legacy-renderer.sh"
source "$ITHACA_BASE_DIR/core/legacy-adapter.sh"
source "$ITHACA_BASE_DIR/core/shadow.sh"

# Modules still executed through the Sentinel contract.
source "$ITHACA_BASE_DIR/modules/fail2ban.sh"
source "$ITHACA_BASE_DIR/modules/ssh.sh"
source "$ITHACA_BASE_DIR/modules/apache.sh"
source "$ITHACA_BASE_DIR/modules/tls.sh"
source "$ITHACA_BASE_DIR/modules/postgres.sh"
source "$ITHACA_BASE_DIR/modules/geoserver.sh"
source "$ITHACA_BASE_DIR/modules/azurearc.sh"
source "$ITHACA_BASE_DIR/modules/certs.sh"

echo "======================================"
echo " ITHACA SECURITY CHECK"
echo " $(date)"
echo "======================================"

ithaca_core_init
source "$ITHACA_BASE_DIR/modules-v12/system.sh"
source "$ITHACA_BASE_DIR/modules-v12/firewall.sh"
source "$ITHACA_BASE_DIR/modules-v12/fail2ban.sh"
_ithaca_registry_lock

section "SYSTEM"
_ithaca_run_registered_checks system
_ithaca_render_results_legacy 0

if [[ "${ITHACA_ADAPTER_DEBUG:-no}" == "yes" ]]; then
    printf '[v1.2 cutover] system active: results=%s\n' \
        "${#ITHACA_RESULT_STATUSES[@]}" >&2
fi

firewall_result_start="${#ITHACA_RESULT_STATUSES[@]}"
section "FIREWALL"
_ithaca_run_registered_check_id "firewall.status"
_ithaca_render_results_legacy "$firewall_result_start"

if [[ "${ITHACA_ADAPTER_DEBUG:-no}" == "yes" ]]; then
    printf '[v1.2 cutover] firewall active: results=1\n' >&2
fi

fail2ban_fragment="$(mktemp)" || exit 4
trap 'rm -f "$fail2ban_fragment"' EXIT INT TERM

check_fail2ban > "$fail2ban_fragment"
cat "$fail2ban_fragment"

_ithaca_results_reset
if ! legacy_parse_fragment "$fail2ban_fragment" fail2ban; then
    printf '[v1.2 shadow] ERROR: %s\n' "$ITHACA_ERROR_MESSAGE" >&2
    exit 4
fi
legacy_fail2ban_statuses=("${ITHACA_RESULT_STATUSES[@]}")
legacy_fail2ban_messages=("${ITHACA_RESULT_MESSAGES[@]}")

_ithaca_results_reset
_ithaca_run_registered_check_id "fail2ban.status"
v12_fail2ban_statuses=("${ITHACA_RESULT_STATUSES[@]}")
v12_fail2ban_messages=("${ITHACA_RESULT_MESSAGES[@]}")

if _ithaca_shadow_compare \
    legacy_fail2ban_statuses legacy_fail2ban_messages \
    v12_fail2ban_statuses v12_fail2ban_messages; then
    if [[ "${ITHACA_ADAPTER_DEBUG:-no}" == "yes" ]]; then
        printf '[v1.2 shadow] fail2ban parity OK: results=%s\n' \
            "${#v12_fail2ban_statuses[@]}" >&2
    fi
else
    printf '[v1.2 shadow] ERROR: %s\n' "$ITHACA_SHADOW_ERROR" >&2
    exit 4
fi

check_ssh
check_apache
check_tls
check_postgres
check_geoserver
check_azurearc
check_certs

clamp_score

echo ""
echo "======================================"
echo " RISULTATO"
echo "======================================"
echo "Warnings : $WARN"
echo "Critical : $CRIT"
echo "Score    : $SCORE/100"
echo "Report   : $REPORT"
echo "======================================"

ln -sf "$REPORT" "$LATEST"

[[ "$CRIT" -eq 0 ]]
